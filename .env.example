# ============================================================
#  NEON ARENA · 环境变量模板
#  用法：cp .env.example .env  然后填入你自己的值
#  ⚠️ .env 已被 .gitignore 排除，绝不要提交
# ============================================================

# ---- 服务 ----
PORT=3066
DATA_DIR=/app/data

# ---- NodeLoc OAuth（可选）----
# 不填也能启动，只是登录功能不可用（服务端会打印 "NodeLoc 未配置"）
# 申请地址：NodeLoc 的 OAuth 应用管理页
#
# ⚠️ redirect_uri 必须与你在 NodeLoc 后台注册的【完全一致】
#    本地开发用 http://localhost:3066/oauth/nodeloc
#    线上用 https://你的域名/oauth/nodeloc
NodeLoc_REDIRECT_URI=https://your-domain.example/oauth/nodeloc
NodeLoc_SCOPE=openid profile

# OAuth 应用凭据（在 NodeLoc 后台创建应用后获得）
NODELOC_CLIENT_ID=
NODELOC_CLIENT_SECRET=

# 会话签名密钥（留空则回退用 CLIENT_SECRET）
NODELOC_SESSION_SECRET=

# Cookie Secure：留空 = 按 REDIRECT_URI 自动判断（https → true）
# 本地 http 调试时可显式设 0
COOKIE_SECURE=
